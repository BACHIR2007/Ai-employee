// AI Employee MVP schema - spec v1.0 section 5 + addendum v1.1 (A-06, A-07, A-09).
//
// Prisma 7 notes:
// - The generator is "prisma-client" and `output` is REQUIRED (the old
//   prisma-client-js provider and node_modules output are no longer supported).
// - There is no `url` in the datasource block. The CLI reads its connection
//   from prisma.config.ts, and the running app uses the Neon driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationPhase {
  IDLE
  ORDER_COLLECTION
  AWAITING_CONFIRMATION
}

enum SenderType {
  CUSTOMER
  AI
}

// A-06: null for customer messages; PENDING/SUCCEEDED/FAILED for AI attempts.
enum AiCallStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// A-07: OFFICE does not collect deliveryAddress.
enum DeliveryMethod {
  HOME
  OFFICE
}

enum OrderStatus {
  NOT_YET_CONFIRMED
  CONFIRMED
  CANCELLED
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  products      Product[]
  conversations Conversation[]
  orders        Order[]
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @db.Uuid
  name          String
  description   String
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int
  // { "sizes": [...], "colors": [...] }. Empty arrays mean "not applicable".
  options       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([businessId])
}

model Conversation {
  id               String            @id @default(uuid()) @db.Uuid
  businessId       String            @db.Uuid
  // The backend owns this phase; the model may suggest but never set it.
  phase            ConversationPhase @default(IDLE)
  // A-09: uncommitted single-product draft. Untrusted: revalidate before use.
  orderDraft       Json?
  // A-09: SHA-256 of the exact normalized draft shown in the latest summary.
  confirmationHash String?
  // A-14: SHA-256 of the anonymous visitor cookie token. Null for rows created
  // before A-14, which are therefore visible only in the owner /admin view.
  // The raw token is never stored.
  visitorKeyHash String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages Message[]
  orders   Order[]

  @@index([businessId])
  // A-14: scoping the public order list by visitor is the hot path.
  @@index([visitorKeyHash, createdAt])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderType     SenderType
  // Nullable only while an AI call is PENDING.
  content        String?
  // Debug aid only. Never returned by a public API or the dashboard.
  rawAiOutput    Json?
  aiCallStatus   AiCallStatus?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderType, createdAt])
}

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  conversationId  String         @db.Uuid
  productId       String         @db.Uuid
  quantity        Int
  size            String?
  color           String?
  customerName    String
  // Normalized Algerian mobile, validated as ^0[567][0-9]{8}$.
  customerPhone   String
  // Snapshot taken from Product at creation time.
  unitPrice       Decimal        @db.Decimal(12, 2)
  deliveryMethod  DeliveryMethod
  // A-01: canonical nameFr of the wilaya.
  wilaya          String
  // A-07: required for HOME, must be null for OFFICE.
  deliveryAddress String?
  // Snapshot of the configured delivery fee.
  deliveryPrice   Decimal        @db.Decimal(12, 2)
  status          OrderStatus    @default(NOT_YET_CONFIRMED)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Restrict: reset keeps the seeded catalog, so orders must never cascade-delete a product.
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([conversationId])
}
