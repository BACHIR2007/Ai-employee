# AI Employee - example environment variables
#
# Copy this file to ".env" for local development, and set the same variable
# names in your Vercel project settings. Never commit a real ".env" file.
# Every value below is an obviously fake placeholder. No real value, no
# passcode and no key belongs in this file or anywhere in the repository.

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------

# Neon POOLED connection URL, used by the running app at runtime.
# Required.
DATABASE_URL=replace-with-neon-pooled-url

# Neon DIRECT connection URL, used only by "prisma migrate" and "prisma db seed".
# Required. Direct connections do not go through the pooler, which is what
# migrations need.
DIRECT_URL=replace-with-neon-direct-url

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------

# Server-only Google Gemini API key. Never exposed to the browser.
# Required.
GEMINI_API_KEY=replace-with-gemini-api-key

# Gemini model name, read from the environment and never hardcoded in source.
# Required.
GEMINI_MODEL=replace-with-gemini-model-name

# ---------------------------------------------------------------------------
# Owner area (/admin) - keep these out of the repository
# ---------------------------------------------------------------------------

# Shared passcode for the hidden owner view. Must be at least 12 characters.
# If it is missing or too short the owner area fails closed and nobody gets in.
# Required. Publish it only in the submission description and demo video.
DASHBOARD_PASSCODE=replace-with-random-passcode-min-12-chars

# Long random string used to sign and validate the owner session cookie.
# Must be at least 32 characters. Required.
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------------
# Limits (all optional: the defaults below apply when unset)
# ---------------------------------------------------------------------------

# Global cap on Gemini calls per hour, shared by everyone using the demo.
# Default 120.
DEMO_AI_CALLS_PER_HOUR=120

# Global cap on Gemini calls per rolling minute. Stops a burst during judging
# before it reaches the provider quota. Default 12.
DEMO_AI_CALLS_PER_MINUTE=12

# Maximum number of customer messages allowed in a single conversation.
# Default 40.
DEMO_MAX_CUSTOMER_MESSAGES_PER_CONVERSATION=40
