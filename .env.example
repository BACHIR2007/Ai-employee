# AI Employee - example environment variables
#
# Copy this file to ".env" for local development, and set the same values in
# your Vercel project settings. Never commit a real ".env" file.
# Every value below is an obviously fake placeholder.

# Neon PostgreSQL POOLED connection URL, used by the running app at runtime.
DATABASE_URL=replace-with-neon-pooled-url

# Neon PostgreSQL DIRECT connection URL, used only for database migrations.
DIRECT_URL=replace-with-neon-direct-url

# Server-only Google Gemini API key. Never expose this to the browser.
GEMINI_API_KEY=replace-with-gemini-api-key

# Gemini model name, read from the environment and never hardcoded in source.
GEMINI_MODEL=replace-with-gemini-model-name

# Shared passcode for the public demo dashboard.
# Use a random value of at least 12 characters, unique to this demo.
DASHBOARD_PASSCODE=replace-with-random-passcode-min-12-chars

# Long random string used to sign and validate the dashboard session cookie.
SESSION_SECRET=replace-with-long-random-string

# Global cap on Gemini calls per hour, shared by everyone using the demo.
DEMO_AI_CALLS_PER_HOUR=120

# Global cap on Gemini calls per rolling minute (addendum A-15).
# Stops a burst during judging before it reaches the provider quota.
# Optional: when unset, the code default of 12 is used.
DEMO_AI_CALLS_PER_MINUTE=12

# Maximum number of customer messages allowed in a single conversation.
DEMO_MAX_CUSTOMER_MESSAGES_PER_CONVERSATION=40